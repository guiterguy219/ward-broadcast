{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ward-broadcast",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // Fonts, favicon, and _headers; anything not found here falls through to the Worker.
  "assets": { "directory": "public" },
  "routes": [{ "pattern": "broadcast.gibsonj.net", "custom_domain": true }],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ward-broadcast",
      "database_id": "1759dfd9-4408-4d22-b794-517e652df79f",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "3b51458eb0cb40de8df68f1bed64120c" }],
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "ward-broadcast-send" }],
    "consumers": [
      {
        "queue": "ward-broadcast-send",
        // One chunk (up to 40 recipients) per run keeps each run under 50 outbound fetches.
        "max_batch_size": 1,
        "max_retries": 5,
        "dead_letter_queue": "ward-broadcast-send-dlq"
      }
    ]
  },
  "vars": {
    // Flip to "true" once texting is live (campaign approved + bishop sign-off).
    "SIGNUPS_OPEN": "false",
    // E.164 Telnyx number; leave empty to hide the "text JOIN" line.
    "TEXT_NUMBER": "+13858959493",
    "CONTACT_EMAIL": "broadcast@gibsonj.net",
    // Base64 Ed25519 key from Telnyx portal > Keys & Credentials > Public Key (not secret).
    // Webhooks are rejected until this is set.
    "TELNYX_PUBLIC_KEY": "cXlTVrcLQT7DNQZTyBky5B1kDBOvF+8R6jupHZ6fbKY=",
    // "app": this Worker answers STOP/START/HELP. "telnyx": the messaging profile does.
    "KEYWORD_REPLIES": "app",
    // Admin name -> SHA-256 hex of a long random passphrase (see src/auth.tsx). Safe to publish.
    "ADMIN_KEYS": "{\"jared\":\"d8a1ebee0b13767aa19c14857f00eb85b154e0324b48b98f67edb9d5476ad48a\"}"
    // Secret (wrangler secret put): TELNYX_API_KEY
  }
}
